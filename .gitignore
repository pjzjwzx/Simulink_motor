# MATLAB / Simulink generated caches and build products
**/slprj/
*.slxc
*.autosave
*.asv
*.m~

# Editor and operating-system noise
.DS_Store
Thumbs.db
Desktop.ini
~$*
*.tmp

# Report render/QA intermediates. Keep the final DOCX/PDF and its builder.
angle_lut_identification/reports/qa/
angle_lut_identification/reports/qa_final/
angle_lut_identification/reports/*.png
angle_lut_identification/reports/*.json

# Simulation runs are large and reproducible. Ignore every run by default.
angle_lut_identification/results/**

# Keep pointers to the formally accepted/latest stages.
!angle_lut_identification/results/latest_stage0.txt
!angle_lut_identification/results/latest_stage1.txt
!angle_lut_identification/results/latest_stage2.txt
!angle_lut_identification/results/latest_stage3.txt
!angle_lut_identification/results/latest_stage4_diagnostic.txt

# Keep audit-sized artifacts from the formal Stage 0 PASS.
!angle_lut_identification/results/stage0_20260818_134242_494/
!angle_lut_identification/results/stage0_20260818_134242_494/**/
!angle_lut_identification/results/stage0_20260818_134242_494/**/*.json
